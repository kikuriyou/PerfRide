services:
  web:
    build:
      context: ./web
      target: dev
    ports:
      - '3000:3000'
    env_file:
      - ./web/.env.local
    volumes:
      - ./web/src:/app/src
      - ./web/public:/app/public
      - type: bind
        source: '~/.config'
        target: '/root/.config'
    environment:
      - AGENT_API_URL=http://agent:8000
      - AGENT_AUDIENCE=http://agent:8000
    depends_on:
      agent:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ['CMD', 'wget', '--spider', '-q', 'http://localhost:3000']
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 15s

  agent:
    build:
      context: ./agent
    ports:
      - '8000:8000'
    volumes:
      - ./agent/src:/app/src
      - ./agent/knowledge:/app/knowledge
      - type: bind
        source: '~/.config'
        target: '/root/.config'
    environment:
      - GOOGLE_CLOUD_PROJECT=your-gcp-project-id
      - GOOGLE_CLOUD_LOCATION=global
      - GOOGLE_GENAI_USE_VERTEXAI=true
      - GCS_BUCKET=your-gcs-bucket
      - WEB_API_URL=http://web:3000
      - RECOMMEND_MODE=hybrid  # hybrid | web_only | no_grounding
      - USE_PERSONAL_DATA=true  # true | false
      - WORKOUT_PLATFORM=intervals_icu  # intervals_icu | mywhoosh_direct | zwift
      - INTERVALS_ICU_API_KEY=  # local fallback only
      - INTERVALS_ICU_ATHLETE_ID=0
      - KMS_KEY_NAME=
      - MYWHOOSH_EMAIL=  # legacy direct-upload fallback only
      - MYWHOOSH_PASSWORD=  # legacy direct-upload fallback only
    restart: unless-stopped
    healthcheck:
      test: ['CMD', 'python', '-c', 'import urllib.request; urllib.request.urlopen("http://localhost:8000/docs")']
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s

  local-weekly-scheduler:
    build:
      context: ./agent
    env_file:
      - ./agent/.env
    volumes:
      - ./agent/src:/app/src
      - local-weekly-scheduler-state:/app/.local-scheduler
    environment:
      LOCAL_WEEKLY_PLAN_AGENT_URL: http://agent:8000
      LOCAL_WEEKLY_PLAN_STATE_FILE: /app/.local-scheduler/weekly-plan-state.json
    command: ['uv', 'run', 'python', '-m', 'recommend_agent.local_scheduler']
    depends_on:
      agent:
        condition: service_healthy
    restart: unless-stopped

volumes:
  local-weekly-scheduler-state:
