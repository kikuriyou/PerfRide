#!/bin/bash
set -euo pipefail

# Configuration
PROJECT_ID="your-gcp-project-id"
REGION="asia-northeast1"
REPO_NAME="perfride-repo"
WEB_SERVICE_NAME="perfride-web"
AGENT_SERVICE_NAME="perfride-agent"
SCHEDULER_JOB_NAME="weekly-plan-trigger"
SCHEDULER_USER_ID="${SCHEDULER_USER_ID:-default}"

WEB_ENV_FILE="web/.env.local"
AGENT_ENV_FILE="agent/.env"
WEB_SERVICE_ACCOUNT=""
AGENT_SERVICE_ACCOUNT=""
SCHEDULER_SERVICE_ACCOUNT="scheduler-invoker@${PROJECT_ID}.iam.gserviceaccount.com"

WEB_IMAGE="${REGION}-docker.pkg.dev/${PROJECT_ID}/${REPO_NAME}/${WEB_SERVICE_NAME}"
AGENT_IMAGE="${REGION}-docker.pkg.dev/${PROJECT_ID}/${REPO_NAME}/${AGENT_SERVICE_NAME}"

# Optional Secret Manager mappings, for example:
# WEB_SET_SECRETS="STRAVA_CLIENT_SECRET=strava-client-secret:latest,NEXTAUTH_SECRET=nextauth-secret:latest"
# AGENT_SET_SECRETS=""
WEB_SET_SECRETS="${WEB_SET_SECRETS:-}"
AGENT_SET_SECRETS="${AGENT_SET_SECRETS:-}"

load_env_file() {
  local file="$1"
  if [ -f "${file}" ]; then
    echo "Loading ${file}"
    set -a
    # shellcheck disable=SC1090
    source "${file}"
    set +a
  else
    echo "Missing ${file}"
    exit 1
  fi
}

require_env() {
  local name="$1"
  if [ -z "${!name:-}" ]; then
    echo "Missing required env: ${name}"
    exit 1
  fi
}

append_optional_flag() {
  local -n target="$1"
  local flag="$2"
  local value="$3"
  if [ -n "${value}" ]; then
    target+=("${flag}" "${value}")
  fi
}

project_number() {
  gcloud projects describe "${PROJECT_ID}" --format='value(projectNumber)'
}

cloud_run_service_account() {
  local service="$1"
  local service_account
  service_account="$(gcloud run services describe "${service}" \
    --platform managed \
    --region "${REGION}" \
    --project "${PROJECT_ID}" \
    --format='value(spec.template.spec.serviceAccountName)' 2>/dev/null || true)"
  if [ -n "${service_account}" ]; then
    echo "${service_account}"
    return
  fi
  echo "$(project_number)-compute@developer.gserviceaccount.com"
}

ensure_service_account() {
  local email="$1"
  local display_name="$2"
  if gcloud iam service-accounts describe "${email}" --project "${PROJECT_ID}" >/dev/null 2>&1; then
    return
  fi

  local account_id="${email%@*}"
  local expected_email="${account_id}@${PROJECT_ID}.iam.gserviceaccount.com"
  if [ "${email}" != "${expected_email}" ]; then
    echo "Missing service account ${email}; create it first or use a ${PROJECT_ID}.iam.gserviceaccount.com account."
    exit 1
  fi

  gcloud iam service-accounts create "${account_id}" \
    --project "${PROJECT_ID}" \
    --display-name "${display_name}"
}

grant_run_invoker() {
  local member_email="$1"
  local label="$2"
  echo "Granting ${label} permission to invoke ${AGENT_SERVICE_NAME}"
  gcloud run services add-iam-policy-binding "${AGENT_SERVICE_NAME}" \
    --region "${REGION}" \
    --project "${PROJECT_ID}" \
    --member "serviceAccount:${member_email}" \
    --role roles/run.invoker >/dev/null
}

load_env_file "${WEB_ENV_FILE}"
load_env_file "${AGENT_ENV_FILE}"

require_env STRAVA_CLIENT_ID
require_env NEXTAUTH_URL_PRODUCTION
require_env GCS_BUCKET
require_env GOOGLE_CLOUD_PROJECT
require_env GOOGLE_CLOUD_LOCATION
require_env GOOGLE_GENAI_USE_VERTEXAI
require_env WEB_API_URL

if [ -z "${WEB_SET_SECRETS}" ]; then
  require_env STRAVA_CLIENT_SECRET
  require_env NEXTAUTH_SECRET
fi

echo "Deploying PerfRide to Cloud Run"
echo "Project: ${PROJECT_ID}"
echo "Region: ${REGION}"
echo "Web service: ${WEB_SERVICE_NAME}"
echo "Agent service: ${AGENT_SERVICE_NAME}"
echo "Production web URL: ${NEXTAUTH_URL_PRODUCTION}"
echo ""

echo "Ensuring Artifact Registry repository exists"
gcloud artifacts repositories describe "${REPO_NAME}" \
  --location="${REGION}" \
  --project="${PROJECT_ID}" >/dev/null 2>&1 || \
gcloud artifacts repositories create "${REPO_NAME}" \
  --repository-format=docker \
  --location="${REGION}" \
  --project="${PROJECT_ID}" \
  --description="Docker repository for PerfRide"

echo "Configuring Docker authentication"
gcloud auth configure-docker "${REGION}-docker.pkg.dev" --quiet

echo "Building and pushing agent image"
docker build -t "${AGENT_IMAGE}:latest" ./agent
docker push "${AGENT_IMAGE}:latest"

echo "Deploying private agent service"
AGENT_DEPLOY_ARGS=(
  run deploy "${AGENT_SERVICE_NAME}"
  --image "${AGENT_IMAGE}:latest"
  --platform managed
  --region "${REGION}"
  --project "${PROJECT_ID}"
  --no-allow-unauthenticated
  --port 8000
  --memory 1Gi
  --cpu 1
  --min-instances 0
  --max-instances 2
  --set-env-vars "GCS_BUCKET=${GCS_BUCKET},GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT},GOOGLE_CLOUD_LOCATION=${GOOGLE_CLOUD_LOCATION},GOOGLE_GENAI_USE_VERTEXAI=${GOOGLE_GENAI_USE_VERTEXAI},WEB_API_URL=${WEB_API_URL},RECOMMEND_MODE=${RECOMMEND_MODE:-hybrid},USE_PERSONAL_DATA=${USE_PERSONAL_DATA:-true},WORKOUT_PLATFORM=${WORKOUT_PLATFORM:-intervals_icu},KMS_KEY_NAME=${KMS_KEY_NAME:-}"
)
append_optional_flag AGENT_DEPLOY_ARGS --service-account "${AGENT_SERVICE_ACCOUNT}"
append_optional_flag AGENT_DEPLOY_ARGS --set-secrets "${AGENT_SET_SECRETS}"
gcloud "${AGENT_DEPLOY_ARGS[@]}"

AGENT_SERVICE_URL=$(gcloud run services describe "${AGENT_SERVICE_NAME}" \
  --region "${REGION}" \
  --project "${PROJECT_ID}" \
  --format 'value(status.url)')

echo "Building and pushing web image"
docker build \
  --build-arg NEXT_PUBLIC_ENV=production \
  --build-arg NEXT_PUBLIC_VAPID_PUBLIC_KEY="${NEXT_PUBLIC_VAPID_PUBLIC_KEY:-}" \
  -t "${WEB_IMAGE}:latest" ./web
docker push "${WEB_IMAGE}:latest"

echo "Deploying public web service"
WEB_ENV_VARS="NODE_ENV=production,STRAVA_CLIENT_ID=${STRAVA_CLIENT_ID},NEXTAUTH_URL=${NEXTAUTH_URL_PRODUCTION},GCS_BUCKET=${GCS_BUCKET},GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT},AGENT_API_URL=${AGENT_SERVICE_URL},AGENT_AUDIENCE=${AGENT_SERVICE_URL},STRAVA_WEBHOOK_VERIFY_TOKEN=${STRAVA_WEBHOOK_VERIFY_TOKEN:-},NEXT_PUBLIC_VAPID_PUBLIC_KEY=${NEXT_PUBLIC_VAPID_PUBLIC_KEY:-},VAPID_CONTACT_EMAIL=${VAPID_CONTACT_EMAIL:-},NEXT_PUBLIC_ENV=production,KMS_KEY_NAME=${KMS_KEY_NAME:-}"
if [ -z "${WEB_SET_SECRETS}" ]; then
  WEB_ENV_VARS="${WEB_ENV_VARS},STRAVA_CLIENT_SECRET=${STRAVA_CLIENT_SECRET},NEXTAUTH_SECRET=${NEXTAUTH_SECRET},VAPID_PRIVATE_KEY=${VAPID_PRIVATE_KEY:-},LINE_CHANNEL_ACCESS_TOKEN=${LINE_CHANNEL_ACCESS_TOKEN:-}"
fi
WEB_DEPLOY_ARGS=(
  run deploy "${WEB_SERVICE_NAME}"
  --image "${WEB_IMAGE}:latest"
  --platform managed
  --region "${REGION}"
  --project "${PROJECT_ID}"
  --allow-unauthenticated
  --port 8080
  --memory 512Mi
  --cpu 1
  --min-instances 0
  --max-instances 3
  --set-env-vars "${WEB_ENV_VARS}"
)
append_optional_flag WEB_DEPLOY_ARGS --service-account "${WEB_SERVICE_ACCOUNT}"
append_optional_flag WEB_DEPLOY_ARGS --set-secrets "${WEB_SET_SECRETS}"
gcloud "${WEB_DEPLOY_ARGS[@]}"

WEB_SERVICE_URL=$(gcloud run services describe "${WEB_SERVICE_NAME}" \
  --region "${REGION}" \
  --project "${PROJECT_ID}" \
  --format 'value(status.url)')

echo "Ensuring weekly scheduler exists"
WEEKLY_PLAN_URL="${AGENT_SERVICE_URL}/api/agent/weekly-plan"
SCHEDULER_BODY="$(printf '{"user_id":"%s","trigger":"scheduler"}' "${SCHEDULER_USER_ID}")"
ensure_service_account "${SCHEDULER_SERVICE_ACCOUNT}" "PerfRide scheduler invoker"
grant_run_invoker "${SCHEDULER_SERVICE_ACCOUNT}" "Cloud Scheduler service account"
if gcloud scheduler jobs describe "${SCHEDULER_JOB_NAME}" \
  --location="${REGION}" \
  --project="${PROJECT_ID}" >/dev/null 2>&1; then
  gcloud scheduler jobs update http "${SCHEDULER_JOB_NAME}" \
    --location="${REGION}" \
    --project="${PROJECT_ID}" \
    --schedule="0 4 * * 1" \
    --time-zone="Asia/Tokyo" \
    --uri="${WEEKLY_PLAN_URL}" \
    --http-method=POST \
    --headers="Content-Type=application/json" \
    --message-body="${SCHEDULER_BODY}" \
    --oidc-service-account-email="${SCHEDULER_SERVICE_ACCOUNT}" \
    --oidc-token-audience="${AGENT_SERVICE_URL}" \
    --attempt-deadline=600s
else
  gcloud scheduler jobs create http "${SCHEDULER_JOB_NAME}" \
    --location="${REGION}" \
    --project="${PROJECT_ID}" \
    --schedule="0 4 * * 1" \
    --time-zone="Asia/Tokyo" \
    --uri="${WEEKLY_PLAN_URL}" \
    --http-method=POST \
    --headers="Content-Type=application/json" \
    --message-body="${SCHEDULER_BODY}" \
    --oidc-service-account-email="${SCHEDULER_SERVICE_ACCOUNT}" \
    --oidc-token-audience="${AGENT_SERVICE_URL}" \
    --attempt-deadline=600s
fi

WEB_RUNTIME_SA="$(cloud_run_service_account "${WEB_SERVICE_NAME}")"
grant_run_invoker "${WEB_RUNTIME_SA}" "web runtime service account"

echo ""
echo "Deployment complete"
echo "Web service URL: ${WEB_SERVICE_URL}"
echo "Agent service URL: ${AGENT_SERVICE_URL}"
echo "Custom web URL: ${NEXTAUTH_URL_PRODUCTION}"
echo ""
echo "Post-deploy checks:"
echo "- Set SCHEDULER_USER_ID to the production Strava athlete id if weekly plans should appear in that user's UI."
echo "- Add the production Strava callback domain without protocol or path."
